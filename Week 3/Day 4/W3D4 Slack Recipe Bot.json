    {
      "parameters": {
        "jsCode": "const info = $('Edit Fields').first().json;\n\nreturn $input.all().map(item => {\n  const answer = (item.json.text || '').trim();\n  const isSorry = answer.toLowerCase().startsWith('sorry');\n  return {\n    json: {\n      channel: info.channel,\n      text: isSorry\n        ? `🤔 ${answer}`\n        : `🍳 *Ingredients for ${info.recipe}*\\n\\n${answer}\\n\\n_— Recipe Bot (n8n + AI)_`\n    }\n  };\n});"
